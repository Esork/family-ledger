generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  userId       String        @id @map("user_id")
  username     String        @unique
  passwordHash String        @map("password_hash")
  salt         String
  displayName  String        @map("display_name")
  createdAt    String?       @map("created_at")
  sessions     Session[]
  transactions Transaction[]

  @@map("users")
}

model Session {
  token     String @id
  userId    String @map("user_id")
  expiresAt Int    @map("expires_at")
  user      User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("sessions")
}

model Category {
  categoryId   String        @id @map("category_id")
  name         String
  type         String
  icon         String?
  sort         Int?
  items        Item[]
  transactions Transaction[]

  @@map("categories")
}

model Item {
  itemId     String   @id @map("item_id")
  categoryId String   @map("category_id")
  name       String
  createdBy  String?  @map("created_by")
  useCount   Int      @default(0) @map("use_count")
  lastUsed   Int?     @map("last_used")
  category   Category @relation(fields: [categoryId], references: [categoryId])

  @@index([categoryId], map: "idx_items_category")
  @@map("items")
}

model Transaction {
  txId       String   @id @map("tx_id")
  date       String
  userId     String   @map("user_id")
  type       String
  categoryId String   @map("category_id")
  itemName   String?  @map("item_name")
  amount     Float
  note       String?
  createdAt  String?  @map("created_at")
  user       User     @relation(fields: [userId], references: [userId])
  category   Category @relation(fields: [categoryId], references: [categoryId])

  @@index([date], map: "idx_tx_date")
  @@index([categoryId], map: "idx_tx_category")
  @@map("transactions")
}
